# =============================================================================
#  CamRevert — plantilla de claves
# =============================================================================
#
#  CÓMO SE USA
#  -----------
#  1. Copia este archivo a `secrets.properties` (en la raíz del proyecto):
#
#         Copy-Item secrets.properties.example secrets.properties
#         notepad secrets.properties
#
#     (También vale llamarlo `.env`: la app acepta los dos nombres y usa
#      `secrets.properties` si existen ambos.)
#
#  2. Rellena TUS datos y compila. Los valores se inyectan en `BuildConfig` y la app
#     los usa como valores de fábrica la primera vez que arranca.
#
#  `secrets.properties` / `.env` están en `.gitignore`: NUNCA se suben a GitHub.
#  Sin ese archivo el proyecto **compila igual** (con valores vacíos) y luego se
#  rellenan a mano desde el diálogo de *Configuración* dentro de la app.
#
#  También puedes ignorar este archivo por completo y escribir todo desde el diálogo
#  de Configuración del dispositivo: se guarda en SharedPreferences, 100% local.
#
# =============================================================================


# -----------------------------------------------------------------------------
#  1. TU CÁMARA  (red local)
# -----------------------------------------------------------------------------

# TU_IP — IP de la cámara en tu red wifi. La ves en el router o con la app oficial.
cam.ip=TU_IP

# VUID — identificador de la cámara: 13 caracteres y empieza por `VE`.
#        Suele venir impreso en la etiqueta del equipo y en la app oficial.
cam.uid=VUID
cam.vuid=VUID

# ID P2P real de la cámara: 17 caracteres (p. ej. `VPTN…`). Es el `did2` que necesita
# el SDK para montar el túnel de control. Lo saca la app oficial en su nube; también
# aparece en el log del SDK como `clientId`.
cam.p2pDid=ID_P2P_17_CARACTERES

# Dirección P2P `DAS-...` del equipo (`DAS-` + 128 hex = 132 caracteres). El SDK la
# exige como `serverParam` para conectar. La app oficial la baja de su nube.
cam.dasAddress=DAS_132_CARACTERES


# -----------------------------------------------------------------------------
#  2. USUARIO Y CLAVE DE LA CÁMARA  (los del vídeo RTSP y del login P2P)
# -----------------------------------------------------------------------------

# Usuario de la CÁMARA. En estas O-KAM/VStarcam casi siempre es `admin`.
cam.user=admin

# CAMPASSWORD — la contraseña de la CÁMARA (la que pide la app oficial para ver el
# vídeo). NO es la de tu cuenta. 8 caracteres o menos en la mayoría de modelos.
cam.password=CAMPASSWORD

# Puertos RTSP de cada lente (por defecto 10555 la fija y 10554 el domo PTZ).
cam.portFixed=10555
cam.portPtz=10554


# -----------------------------------------------------------------------------
#  3. TU CUENTA EYE4  (la del visor oficial de O-KAM Pro)
# -----------------------------------------------------------------------------
#
#  ¿POR QUÉ HACE FALTA ESTO?
#  La cámara NO ejecuta ninguna orden (PTZ, luz, sirena…) hasta que se le presenta un
#  token firmado de tu cuenta EYE4 dentro de la sesión:
#
#      eye4_authentication.cgi?loginAccount=<userid>&loginToken=<token>&
#
#  Sin eso responde `result=-2` a todo (el vídeo sí se ve, pero no se mueve nada).
#  El token se pide por HTTPS a api.eye4.cn en cada conexión y NO se guarda.
#  Si dejas estas dos líneas vacías, la app funciona igual salvo que los controles
#  no responderán (la consola P2P lo avisa con «SIN TOKEN DE CUENTA»).
#
#  Se puede poner desde el diálogo de Configuración → «Cuenta EYE4 (email)» y
#  «Clave de la cuenta».

# TUCORREO — el email con el que entras en la app oficial de O-KAM Pro.
cam.accountUser=TUCORREO

# PASSWORD — la contraseña de ESA CUENTA (no la de la cámara).
cam.accountPassword=PASSWORD

# CAMPPCSLICENSE — licencia del SDK P2P: un InitString de 108 caracteres que vive
#  dentro de libOKSMARTPPCS.so (@0x25d10). Es del FABRICANTE, no tuya, pero se guarda
#  aquí para que no viaje en el repositorio (el .c la recibe como argumento).
#  Sin ella la app compila y el túnel sigue funcionando por `cachedIps`; solo se omite
#  `PPCS_Initialize` (la consola P2P avisa «InitString=AUSENTE»). Ver AGENTS.md §10.9.
cam.ppcsLicense=CAMPPCSLICENSE

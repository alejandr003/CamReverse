<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/tvCallState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/state_idle"
        android:textColor="@color/cr_text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvCallEffects"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="monospace"
        android:textColor="@color/cr_text_dim"
        android:textSize="11sp"
        tools:text="Eco: Sí · Ruido: Sí" />

    <!-- Selector de modo -->
    <RadioGroup
        android:id="@+id/callModeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rbCallDuplex"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:button="@null"
            android:gravity="center_vertical"
            android:minHeight="46dp"
            android:text="@string/call_mode_duplex"
            android:textColor="@color/cr_text_primary"
            android:textSize="14sp"
            tools:ignore="RtlSymmetry" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/call_mode_duplex_hint"
            android:textColor="@color/cr_text_dim"
            android:textSize="11sp" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rbCallPtt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:button="@null"
            android:gravity="center_vertical"
            android:minHeight="46dp"
            android:text="@string/call_mode_ptt"
            android:textColor="@color/cr_text_primary"
            android:textSize="14sp"
            tools:ignore="RtlSymmetry" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/call_mode_ptt_hint"
            android:textColor="@color/cr_text_dim"
            android:textSize="11sp" />
    </RadioGroup>

    <!-- Botón grande de inicio/parada -->
    <LinearLayout
        android:id="@+id/btnCallToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_mic"
            tools:ignore="RtlSymmetry" />

        <TextView
            android:id="@+id/tvCallToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/call_start"
            android:textColor="@color/cr_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Zona de radio: mantener pulsado para hablar (solo PTT) -->
    <TextView
        android:id="@+id/btnPtt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_siren"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:padding="18dp"
        android:text="@string/call_ptt_label"
        android:textColor="@color/cr_text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>

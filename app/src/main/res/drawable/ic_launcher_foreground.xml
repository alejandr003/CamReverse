<?xml version="1.0" encoding="utf-8"?>
<!--
  Emblema PTZ para el icono adaptativo.

  Todo el dibujo va dentro de un grupo al 80 %: el lienzo del icono adaptativo mide
  108×108 dp pero el lanzador solo garantiza visible el círculo central de 66 dp
  (radio 33). El anillo orbital llega a radio 34 y las puntas de las flechas a 41,
  así que sin reducirlo se recortarían los arcos en la mayoría de máscaras.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.8"
        android:scaleY="0.8">

        <!-- Anillo orbital exterior PTZ (flechas de rotación) -->
        <!-- Arco superior-derecho -->
        <path
            android:pathData="M54,20 A34,34 0 0,1 88,54"
            android:strokeColor="#4CAF50"
            android:strokeWidth="3.5"
            android:strokeLineCap="round" />
        <!-- Flecha derecha -->
        <path
            android:pathData="M84,48 L88,55 L95,50"
            android:fillColor="#4CAF50"
            android:strokeColor="#4CAF50"
            android:strokeWidth="1"
            android:strokeLineJoin="round" />

        <!-- Arco inferior-izquierdo -->
        <path
            android:pathData="M54,88 A34,34 0 0,1 20,54"
            android:strokeColor="#4CAF50"
            android:strokeWidth="3.5"
            android:strokeLineCap="round" />
        <!-- Flecha izquierda -->
        <path
            android:pathData="M24,60 L20,53 L13,58"
            android:fillColor="#4CAF50"
            android:strokeColor="#4CAF50"
            android:strokeWidth="1"
            android:strokeLineJoin="round" />

        <!-- Carcasa base del domo -->
        <path
            android:pathData="M34,44 L74,44 A20,20 0 0,1 54,74 A20,20 0 0,1 34,44 Z"
            android:fillColor="#263238"
            android:strokeColor="#37474F"
            android:strokeWidth="2" />

        <!-- Soporte superior del domo -->
        <path
            android:pathData="M30,42 L78,42 L74,36 L34,36 Z"
            android:fillColor="#455A64" />

        <!-- Anillo exterior de la lente principal -->
        <path
            android:pathData="M54,54m-13,0a13,13 0,1 1,26 0a13,13 0,1 1,-26 0"
            android:fillColor="#0F1316"
            android:strokeColor="#2E7D32"
            android:strokeWidth="2" />

        <!-- Pupila de la lente -->
        <path
            android:pathData="M54,54m-7,0a7,7 0,1 1,14 0a7,7 0,1 1,-14 0"
            android:fillColor="#1E282D" />

        <!-- Sensor / indicador de estado activo (verde live) -->
        <path
            android:pathData="M54,54m-3,0a3,3 0,1 1,6 0a3,3 0,1 1,-6 0"
            android:fillColor="#00E676" />

        <!-- Brillo del cristal de la lente -->
        <path
            android:pathData="M50,49 A5,5 0 0,1 56,49"
            android:strokeColor="#FFFFFF"
            android:strokeAlpha="0.6"
            android:strokeWidth="1.5"
            android:strokeLineCap="round" />

    </group>
</vector>

<?xml version="1.0" encoding="utf-8"?>
<!-- Sirena SONANDO: rojo sólido, para que el estado se lea de un vistazo.
     El apagado usa `bg_siren` (rojo translúcido) y el encendido este. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E5484D" />
    <stroke
        android:width="1dp"
        android:color="#FFFF8A8A" />
    <corners android:radius="14dp" />
</shape>
